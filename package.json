{
  "name": "agentic-os",
  "version": "0.1.0",
  "description": "Local-only control panel for a personal Claude meta-stack: engram memory browser, friction-log timeline, skill launcher, token-usage trends, session-wrap history.",
  "author": "Kiran Pachhai",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "node scripts/doctor.mjs",
    "gate": "node scripts/gate.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "better-sqlite3": "^12.11.1",
    "dompurify": "^3.4.11",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.28",
    "marked": "^18.0.5",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
